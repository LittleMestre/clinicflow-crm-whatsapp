NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://clinicflow:local_dev_only@localhost:5433/clinicflow
WEB_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32  (64 hexadecimal characters)
APP_ENCRYPTION_KEY=replace_with_64_hex_characters_before_connecting_a_real_account
# mock = no real WhatsApp messages sent; live = use Meta Cloud API
WHATSAPP_MODE=mock
META_GRAPH_VERSION=v26.0
# App-level configuration from Meta for Developers (never commit actual values):
META_APP_SECRET=
META_VERIFY_TOKEN=
# Development demo only; never enable on a production database:
SEED_DEMO=true
